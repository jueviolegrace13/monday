root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,html,scss,css}]
indent_size = 2

[*.cs]
# Domain language wins over suffix rules: "Permission" is the business word.
dotnet_diagnostic.CA1711.severity = none
# Domain exceptions carry a code and message; the parameterless constructors add nothing.
dotnet_diagnostic.CA1032.severity = none
